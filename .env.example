# ── Site (website project) ─────────────────────────────────────
# Canonical origin. Switch to https://punebookies.com when the domain exists.
SITE_URL=https://pune-bookies.vercel.app

# ── CMS reads (build time; optional — site falls back to hardcoded content) ──
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Homepage gallery from synced Sunday photos (leave off until real photos exist)
SHOW_SUNDAY_PHOTOS=false

# ── Inquiry form (serverless, server-only — NEVER prefix these PUBLIC_) ──
# Email: prefer RESEND once a domain is verified; BREVO works today
# with a verified single sender (no domain needed). See ANALYTICS.md.
RESEND_API_KEY=
BREVO_API_KEY=
INQUIRY_TO=tanvi.lele3944@gmail.com,shreyasjadhav531@gmail.com
INQUIRY_FROM=Pune Bookies <onboarding@resend.dev>
# Sanity write token (Editor) for creating partnerInquiry documents
SANITY_WRITE_TOKEN=

# ── Analytics (optional; site ships zero analytics without these) ──
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
