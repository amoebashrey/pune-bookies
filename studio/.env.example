# ── Sanity project (from sanity.io/manage after creating the project) ──
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# ── For scripts/seed.mjs and scripts/sync-drive.mjs only ──
# An "Editor" token: sanity.io/manage → API → Tokens → Add token.
# NEVER put this in the website project or any PUBLIC_ variable.
SANITY_WRITE_TOKEN=

# ── Google Drive sync (scripts/sync-drive.mjs) ──
# Path to the service-account key file you downloaded in STUDIO_SETUP.md step 3.
# Keep the file OUT of git (it's in .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
