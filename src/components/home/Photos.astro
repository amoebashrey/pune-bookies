---
// Real Sunday photos arrive via the Drive→Sanity pipeline behind the
// SHOW_SUNDAY_PHOTOS=true flag; until then, admitted placeholders.
import { getSundayPhotos } from '../../lib/cms';
const sundayPhotos = await getSundayPhotos();   // null until flag + photos exist

const tiles = [
  { cls: 't1',  src: '/photos/sunday-2.jpg',  alt: 'A Sunday with Pune Bookies', w: 878,  h: 1200 },
  { cls: 't2',  src: '/photos/sunday-3.jpg',  alt: 'A Sunday with Pune Bookies', w: 965,  h: 1200 },
  { cls: 't3',  src: '/photos/sunday-4.jpg',  alt: 'A Sunday with Pune Bookies', w: 804,  h: 1200 },
  { cls: 't4',  src: '/photos/sunday-5.jpg',  alt: 'A Sunday with Pune Bookies', w: 863,  h: 1200 },
  { cls: 't5',  src: '/photos/sunday-1.jpg',  alt: 'A Sunday with Pune Bookies', w: 1200, h: 1109 },
  { cls: 't6',  src: '/photos/sunday-6.jpg',  alt: 'A Sunday with Pune Bookies', w: 857,  h: 1200 },
  { cls: 't7',  src: '/photos/sunday-7.jpg',  alt: 'A Sunday with Pune Bookies', w: 920,  h: 1200 },
  { cls: 't8',  src: '/photos/sunday-9.jpg',  alt: 'A Sunday with Pune Bookies', w: 974,  h: 1200 },
  { cls: 't9',  src: '/photos/sunday-10.jpg', alt: 'A Sunday with Pune Bookies', w: 1033, h: 1200 },
  { cls: 't10', src: '/photos/sunday-8.jpg',  alt: 'A Sunday with Pune Bookies', w: 1050, h: 1200 },
  { cls: 't11', src: '/photos/sunday-11.jpg', alt: 'A Sunday with Pune Bookies', w: 976,  h: 1200 },
];
---
<section class="atmosphere">
  <div class="container">

    <div class="section-head">
      <span class="eyebrow">what it looks like</span>
      <h2 class="display">A year of <em>Sundays</em>.</h2>
    </div>

    {sundayPhotos ? (
      <div class="photo-grid">
        {sundayPhotos.map((p, i) => (
          <figure class:list={['photo-tile', ['t1', 't2', 't4', 't5'][i] ?? 't1']}>
            <img src={p.url} alt={p.alt} width="900" height="1125" loading="lazy" decoding="async" />
            {p.cap && <figcaption class="photo-caption">{p.cap}</figcaption>}
          </figure>
        ))}
      </div>
    ) : (
      <div class="photo-grid">
        {tiles.map((t) => (
          <figure class:list={['photo-tile', t.cls]}>
            <img src={t.src} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    )}

  </div>
</section>
