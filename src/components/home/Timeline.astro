---
const rows = [
  { time: 'Sat, 4:05 PM', filled: true,  h: 'The location goes out', p: "Every Saturday at 4:05 in the afternoon, the next morning's spot is shared in the WhatsApp groups. Could be a park, could be a farm, could be a botanical garden. It changes weekly." },
  { time: '7:45 AM', filled: false, h: "You're heading there", p: "Bring a book. A water bottle. Sunglasses if you need them. Something to sit on if grass and you aren't friends. That's it." },
  { time: '8:00 AM', filled: true,  h: 'Show up. Hello.', p: "There's a small welcome table. A bookmark for you. A basket for the page-guessing game — drop in your guess for how many pages we'll collectively read today. We mean it. Pen and paper." },
  { time: '8:30 AM', filled: false, h: 'Pick a spot. Read.', p: "This is not a book club. We don't discuss the book. Everyone reads their own thing. The silence is the point. Two hours of it, more or less, with the wind doing whatever it does." },
  { time: '9:00 AM', filled: true,  h: 'Page guesses get collected', p: "Someone walks past the basket and takes the slips. We add up the pages everyone read. The closest guess wins something small — a bookmark from a previous week, a postcard. We don't make a thing of it." },
  { time: '9:45 AM', filled: false, h: 'A gentle wrap-up', p: "Someone walks through the readers letting people know we'll wrap soon. Group photo at 9:50 if you want to be in it. If you don't, you step to the side. No explanation needed." },
  { time: '10:00 AM', filled: true, h: 'Some people leave. Some stay.', p: "The official Sunday is over. Some head off to breakfast. Some stand around and talk about what they read, what they didn't, the weather, whatever. A few people meet a friend they didn't know they had." },
];
---
<section class="how-it-works" id="sundays" tabindex="-1">
  <div class="container">

    <div class="section-head">
      <span class="eyebrow">how Sunday actually works</span>
      <h2 class="display">It's <em>simpler</em> than you think.</h2>
    </div>

    <ol class="timeline">
      {rows.map((r) => (
        <li class="timeline-row">
          <div class="timeline-time">{r.time}</div>
          <div class:list={['timeline-dot', { filled: r.filled }]}></div>
          <div class="timeline-content">
            <h3>{r.h}</h3>
            <p>{r.p}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
