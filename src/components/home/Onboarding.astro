---
/**
 * Watercolour onboarding — plays once per session, homepage only.
 * Three painted frames bloom in sequence (distance → walking → seated),
 * then the overlay fades to reveal the hero. Frame 3 IS the hero painting
 * at the same position/scale, so the handoff is seamless.
 *
 * Gated pre-paint by `data-onboard` (set in index.astro's head slot):
 * reduced-motion and returning visitors get `skip` → no overlay, hero
 * shows instantly. The overlay is aria-hidden and never traps focus.
 */
---
<div class="onboard" aria-hidden="true">
  <div class="onboard-stage">
    <picture class="onboard-frame" data-frame="1">
      <source srcset="/illustrations/onboard-1-distance.webp" type="image/webp" />
      <img src="/illustrations/onboard-1-distance.png" width="1376" height="768" alt="" decoding="async" />
    </picture>
    <picture class="onboard-frame" data-frame="2">
      <source srcset="/illustrations/onboard-2-walking.webp" type="image/webp" />
      <img src="/illustrations/onboard-2-walking.png" width="1376" height="768" alt="" decoding="async" />
    </picture>
    <picture class="onboard-frame" data-frame="3">
      <source srcset="/illustrations/onboard-3-hero.webp" type="image/webp" />
      <img src="/illustrations/onboard-3-hero.png" width="1376" height="768" alt="" decoding="async" />
    </picture>
  </div>
  <div class="onboard-petals" aria-hidden="true"></div>
  <button type="button" class="onboard-skip" tabindex="-1">skip</button>
</div>

<script is:inline>
(function () {
  var root = document.documentElement;
  if (root.getAttribute('data-onboard') !== 'play') return;   // skip path decided pre-paint
  var overlay = document.querySelector('.onboard');
  if (!overlay) return;

  var BLOOM = 1100, HOLD = 1000, FADE = 700;                  // ~6s of frames, then fade
  var frames = [].slice.call(overlay.querySelectorAll('.onboard-frame'));
  var petalsLayer = overlay.querySelector('.onboard-petals');
  var skipBtn = overlay.querySelector('.onboard-skip');
  var timers = [], finished = false;

  // Settle the hero underneath so the reveal is seamless no matter what the
  // old arrival bloom did (it is disabled on this path, but be defensive).
  function settleHero() {
    root.setAttribute('data-arrival', 'done');
    var inner = document.querySelector('.hero .hero-inner');
    if (inner) inner.classList.add('reveal', 'visible');
  }

  function finish() {
    if (finished) return; finished = true;
    timers.forEach(clearTimeout);
    try { sessionStorage.setItem('pb_onboard_v1', '1'); } catch (e) {}
    settleHero();
    overlay.classList.add('is-leaving');                      // opacity → 0 via CSS
    var gone = function () { overlay.style.display = 'none'; };
    overlay.addEventListener('transitionend', gone, { once: true });
    setTimeout(gone, FADE + 250);                             // failsafe
  }

  // Petals — the site's gulmohar motif, drifting down over the sequence.
  var PETAL = 'M10 0 C16 8 18 19 10 28 C2 19 4 8 10 0 Z';
  var COLORS = ['#c8553d', '#d97863', '#e8a89a'];
  function spawnPetals(n) {
    for (var i = 0; i < n; i++) {
      var p = document.createElement('span');
      p.className = 'onboard-petal';
      var size = 10 + (i * 5) % 9;
      p.style.left = (6 + (i * 13) % 86) + '%';
      p.style.width = size + 'px';
      p.style.height = (size * 1.4) + 'px';
      p.style.animationDuration = (5 + (i % 4)) + 's';
      p.style.animationDelay = (i * 0.45) + 's';
      p.innerHTML = '<svg viewBox="0 0 20 28" width="100%" height="100%"><path d="' + PETAL + '" fill="' + COLORS[i % 3] + '"/></svg>';
      petalsLayer.appendChild(p);
    }
  }

  function play() {
    spawnPetals(7);
    frames.forEach(function (f, i) {
      timers.push(setTimeout(function () { f.classList.add('is-blooming'); }, i * (BLOOM + HOLD)));
    });
    timers.push(setTimeout(finish, frames.length * (BLOOM + HOLD)));
  }

  skipBtn.addEventListener('click', finish);
  document.addEventListener('keydown', function (e) { if (!finished && e.key === 'Escape') finish(); });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', play);
  else play();
})();
</script>
