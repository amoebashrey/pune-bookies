---
import { getSettings } from '../../lib/cms';
const settings = await getSettings();
---
<section class="hero">
  <div class="hero-inner">

    <div class="hero-illustration">
      <!-- Watercolour painting: readers seated under the gulmohar.
           Frame 3 of the onboarding sequence — same image, so the
           onboarding overlay hands off to this seamlessly. -->
      <picture>
        <source srcset="/illustrations/onboard-3-hero.webp" type="image/webp" />
        <img
          src="/illustrations/onboard-3-hero.png"
          width="1376" height="768"
          alt="A watercolour gulmohar tree with readers seated beneath it"
          fetchpriority="high" decoding="async"
        />
      </picture>
    </div>

    <h1 class="hero-wordmark display">
      <span class="pune">Pune</span>
      <span class="bookies">Bookies</span>
    </h1>

    <p class="hero-tagline">
      {settings.heroTagline}
      <span class="stress"><Fragment set:html={settings.heroStress} />
        <svg class="tree-glyph" viewBox="0 0 20 20" aria-hidden="true"><g><ellipse cx="10" cy="7.5" rx="7" ry="6" fill="#738c5a" opacity="0.55"/><ellipse cx="8" cy="6.5" rx="4.5" ry="4" fill="#9bb07e" opacity="0.6"/><path d="M10 18 L10 9" stroke="#3d2818" stroke-width="1.4" stroke-linecap="round" opacity="0.7"/><path d="M10 12 Q 8 10.5 6.8 9.6" stroke="#3d2818" stroke-width="0.9" stroke-linecap="round" opacity="0.55"/></g></svg>
      </span>
    </p>

    <div class="hero-meta">
      {settings.heroStats.map((s) => (
        <span>
          {s.ig ? (
            <a class="ig-stat" href={settings.igUrl} target="_blank" rel="noopener" data-track="ig_outbound" aria-label={`${s.value} ${s.label} on Instagram`}>
              <strong>{s.value}</strong>{s.label}
              <svg class="ig-glyph" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/></g></svg>
            </a>
          ) : (
            <Fragment><strong>{s.value}</strong>{s.label}</Fragment>
          )}
        </span>
      ))}
    </div>

    <p class="hero-ig">{settings.igPathwayLine} <a href={settings.igUrl} target="_blank" rel="noopener" data-track="ig_outbound">{settings.igHandle}</a></p>

  </div>

  <div class="scroll-cue">↓ keep going</div>
</section>
