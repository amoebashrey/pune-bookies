---
import { settings } from '../../content/site';
---
<section class="hero">
  <div class="hero-inner">

    <div class="hero-illustration">
      <!-- Watercolour tree + sloth illustration -->
      <svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <filter id="watercolour" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.012 0.03" numOctaves="3" seed="3"/>
            <feDisplacementMap in="SourceGraphic" scale="14"/>
          </filter>
          <filter id="paint-edge" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="2" seed="7"/>
            <feDisplacementMap in="SourceGraphic" scale="6"/>
          </filter>
          <radialGradient id="canopy1" cx="0.4" cy="0.4" r="0.7">
            <stop offset="0%" stop-color="#e8a89a" stop-opacity="0.85"/>
            <stop offset="60%" stop-color="#d97863" stop-opacity="0.7"/>
            <stop offset="100%" stop-color="#c8553d" stop-opacity="0.5"/>
          </radialGradient>
          <radialGradient id="canopy2" cx="0.5" cy="0.5" r="0.7">
            <stop offset="0%" stop-color="#f4b8a6" stop-opacity="0.7"/>
            <stop offset="100%" stop-color="#c8553d" stop-opacity="0.3"/>
          </radialGradient>
          <radialGradient id="canopy3" cx="0.5" cy="0.5" r="0.7">
            <stop offset="0%" stop-color="#9bb07e" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="#738c5a" stop-opacity="0.3"/>
          </radialGradient>
          <radialGradient id="ground" cx="0.5" cy="0.3" r="0.6">
            <stop offset="0%" stop-color="#9bb07e" stop-opacity="0.4"/>
            <stop offset="100%" stop-color="#738c5a" stop-opacity="0.15"/>
          </radialGradient>
        </defs>

        <ellipse cx="300" cy="360" rx="200" ry="20" fill="url(#ground)" filter="url(#watercolour)" opacity="0.7"/>

        <ellipse cx="220" cy="130" rx="135" ry="105" fill="url(#canopy3)" filter="url(#watercolour)" opacity="0.7"/>
        <ellipse cx="380" cy="120" rx="130" ry="110" fill="url(#canopy1)" filter="url(#watercolour)" opacity="0.8"/>
        <ellipse cx="300" cy="100" rx="155" ry="95" fill="url(#canopy2)" filter="url(#watercolour)" opacity="0.7"/>
        <ellipse cx="290" cy="160" rx="170" ry="80" fill="url(#canopy1)" filter="url(#watercolour)" opacity="0.55"/>

        <g fill="none" stroke="#3d2818" stroke-linecap="round" filter="url(#paint-edge)">
          <path d="M 300 360 Q 300 280 295 200 Q 290 150 285 100" stroke-width="14" opacity="0.75"/>
          <path d="M 295 200 Q 240 170 195 145" stroke-width="6" opacity="0.65"/>
          <path d="M 297 220 Q 350 200 395 175" stroke-width="7" opacity="0.7"/>
          <path d="M 290 240 Q 250 230 215 220" stroke-width="4" opacity="0.55"/>
          <path d="M 292 180 Q 320 165 345 152" stroke-width="3.5" opacity="0.5"/>
        </g>

        <g filter="url(#paint-edge)">
          <circle cx="180" cy="100" r="6" fill="#c8553d" opacity="0.7"/>
          <circle cx="200" cy="80" r="4" fill="#d97863" opacity="0.6"/>
          <circle cx="240" cy="60" r="5" fill="#c8553d" opacity="0.65"/>
          <circle cx="320" cy="55" r="5" fill="#d97863" opacity="0.7"/>
          <circle cx="360" cy="70" r="4" fill="#c8553d" opacity="0.6"/>
          <circle cx="410" cy="90" r="6" fill="#d97863" opacity="0.65"/>
          <circle cx="430" cy="120" r="4" fill="#c8553d" opacity="0.55"/>
          <circle cx="155" cy="130" r="5" fill="#c8553d" opacity="0.6"/>
          <circle cx="450" cy="155" r="4" fill="#d97863" opacity="0.55"/>
          <circle cx="130" cy="160" r="3" fill="#c8553d" opacity="0.5"/>
          <circle cx="260" cy="190" r="3" fill="#d97863" opacity="0.5"/>
          <circle cx="340" cy="200" r="3" fill="#c8553d" opacity="0.5"/>
          <circle cx="200" cy="280" r="2.5" fill="#d97863" opacity="0.5"/>
          <circle cx="380" cy="290" r="2.5" fill="#c8553d" opacity="0.5"/>
          <circle cx="240" cy="320" r="2" fill="#d97863" opacity="0.4"/>
          <circle cx="360" cy="335" r="2" fill="#c8553d" opacity="0.4"/>
        </g>

        <g filter="url(#paint-edge)" transform="translate(308 195)">
          <ellipse cx="0" cy="0" rx="22" ry="14" fill="#8b6748" opacity="0.85"/>
          <ellipse cx="-3" cy="-2" rx="16" ry="9" fill="#a07d5a" opacity="0.7"/>
          <ellipse cx="18" cy="-8" rx="11" ry="9" fill="#8b6748" opacity="0.85"/>
          <circle cx="22" cy="-9" r="1.5" fill="#1f1611" opacity="0.7"/>
          <circle cx="15" cy="-9" r="1.5" fill="#1f1611" opacity="0.7"/>
          <ellipse cx="-2" cy="6" rx="6" ry="4" fill="#6e4f33" opacity="0.7"/>
          <rect x="-8" y="-2" width="14" height="9" fill="#f4ecd8" opacity="0.9" rx="0.5"/>
          <line x1="-1" y1="-2" x2="-1" y2="7" stroke="#8b6748" stroke-width="0.5" opacity="0.6"/>
        </g>
      </svg>
    </div>

    <h1 class="hero-wordmark display">
      <span class="pune">Pune</span>
      <span class="bookies">Bookies</span>
    </h1>

    <p class="hero-tagline">
      {settings.heroTagline}
      <span class="stress"><Fragment set:html={settings.heroStress} />
        <svg class="tree-glyph" viewBox="0 0 20 20" aria-hidden="true"><g><ellipse cx="10" cy="7.5" rx="7" ry="6" fill="#738c5a" opacity="0.55"/><ellipse cx="8" cy="6.5" rx="4.5" ry="4" fill="#9bb07e" opacity="0.6"/><path d="M10 18 L10 9" stroke="#3d2818" stroke-width="1.4" stroke-linecap="round" opacity="0.7"/><path d="M10 12 Q 8 10.5 6.8 9.6" stroke="#3d2818" stroke-width="0.9" stroke-linecap="round" opacity="0.55"/></g></svg>
      </span>
    </p>

    <div class="hero-meta">
      {settings.heroStats.map((s) => (
        <span><strong>{s.value}</strong>{s.label}</span>
      ))}
    </div>

    <p class="hero-ig">{settings.igPathwayLine} <a href={settings.igUrl} target="_blank" rel="noopener" data-track="ig_outbound">{settings.igHandle}</a></p>

  </div>

  <div class="scroll-cue">↓ keep going</div>
</section>
