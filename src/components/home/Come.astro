---
import { settings } from '../../content/site';
---
<section class="come" id="come" tabindex="-1">
  <div class="container">

    <div class="section-head">
      <span class="eyebrow">how to actually come</span>
      <h2 class="display">Three <em>steps.</em> That's it.</h2>
    </div>

    <div class="come-steps">

      <div class="step">
        <span class="step-num">1</span>
        <h4>Follow on Instagram</h4>
        <p>The bio has the WhatsApp link. <a href={settings.igUrl} target="_blank" rel="noopener" data-track="ig_outbound">{settings.igHandle}</a></p>
      </div>

      <div class="step">
        <span class="step-num">2</span>
        <h4>Join the WhatsApp group</h4>
        <p>The location for next Sunday goes out every Saturday at 4:05 PM. Nothing else.</p>
      </div>

      <div class="step">
        <span class="step-num">3</span>
        <h4>Show up on Sunday</h4>
        <p>8 AM. Bring a book. We'll be there.</p>
      </div>

    </div>

    <p class="closing-line">
      And if it's not for you, that's fine too.
    </p>

  </div>
</section>
