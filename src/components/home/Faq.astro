---
import { getFaqs } from '../../lib/cms';
const faqs = await getFaqs();
---
<section class="faq" id="faq" tabindex="-1">
  <div class="container">

    <div class="section-head">
      <span class="eyebrow">things people quietly wonder</span>
      <h2 class="display">Probably <em>your</em> question.</h2>
    </div>

    <div class="faq-list">
      {faqs.map((f) => (
        <div class="faq-item">
          <h3 class="faq-q">{f.q}<svg class="faq-rule" viewBox="0 0 120 7" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 4 Q 30 1 60 3.5 T 118 3" fill="none" stroke="var(--ink-soft)" stroke-width="1.6" stroke-linecap="round"/></svg></h3>
          <p>{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>
