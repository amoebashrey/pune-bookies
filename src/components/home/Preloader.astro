---
/**
 * Watercolour-bloom preloader — homepage only, plays on EVERY load.
 *
 * A cream overlay built on the single hero painting (onboard-3-hero): it
 * starts soft (oversized, blurred, pale) and dries to sharp full-colour
 * like watercolour onto paper; the wordmark fades up just after; then the
 * overlay dissolves to reveal the real hero. The overlay mirrors the hero's
 * structure (same classes, same top-aligned position/scale), so the painting
 * and wordmark line up exactly — no visible swap.
 *
 * Gated pre-paint by `data-preload` (index.astro head slot): prefers-reduced-
 * motion → "skip" (no overlay, hero instant). Aria-hidden, no focus trap.
 */
import { getSettings } from '../../lib/cms';
const settings = await getSettings();
---
<div class="preloader" aria-hidden="true">
  <div class="preloader-inner hero-inner">
    <div class="hero-illustration preloader-art">
      <picture>
        <source srcset="/illustrations/onboard-3-hero.webp" type="image/webp" />
        <img src="/illustrations/onboard-3-hero.png" width="1376" height="768" alt="" fetchpriority="high" decoding="async" />
      </picture>
    </div>
    <h1 class="hero-wordmark display preloader-wordmark" aria-hidden="true"><span class="pune">Pune</span> <span class="bookies">Bookies</span></h1>
  </div>
  <div class="preloader-petals" aria-hidden="true"></div>
  <button type="button" class="preloader-skip" tabindex="-1">skip</button>
</div>

<script is:inline>
(function () {
  var root = document.documentElement;
  if (root.getAttribute('data-preload') !== 'play') return;   // reduced-motion skip, decided pre-paint
  var overlay = document.querySelector('.preloader');
  if (!overlay) return;

  var MIN = 750, CAP = 1400, FADE = 600;
  var finished = false;

  function settleHero() {
    root.setAttribute('data-arrival', 'done');
    var inner = document.querySelector('.hero .hero-inner');
    if (inner) inner.classList.add('reveal', 'visible');
  }

  function finish() {
    if (finished) return; finished = true;
    settleHero();
    overlay.classList.add('is-leaving');
    var gone = function () { overlay.style.display = 'none'; };
    overlay.addEventListener('transitionend', gone, { once: true });
    setTimeout(gone, FADE + 250);                              // failsafe
  }

  // petals — the site's gulmohar motif, a light dusting over the bloom
  var PETAL = 'M10 0 C16 8 18 19 10 28 C2 19 4 8 10 0 Z';
  var COLORS = ['#c8553d', '#d97863', '#e8a89a'];
  var petalsLayer = overlay.querySelector('.preloader-petals');
  for (var i = 0; i < 6; i++) {
    var p = document.createElement('span');
    p.className = 'preloader-petal';
    var size = 10 + (i * 4) % 8;
    p.style.left = (8 + (i * 16) % 84) + '%';
    p.style.width = size + 'px';
    p.style.height = (size * 1.4) + 'px';
    p.style.animationDuration = (5 + (i % 4)) + 's';
    p.style.animationDelay = (i * 0.5) + 's';
    p.innerHTML = '<svg viewBox="0 0 20 28" width="100%" height="100%"><path d="' + PETAL + '" fill="' + COLORS[i % 3] + '"/></svg>';
    petalsLayer.appendChild(p);
  }

  // hold the soft state until the painting + fonts are ready, with a short
  // minimum and a hard cap so warm-cache refreshes stay light and it never hangs
  var img = overlay.querySelector('.preloader-art img');
  var imgReady = (img && img.complete) ? Promise.resolve()
    : new Promise(function (res) {
        if (!img) return res();
        img.addEventListener('load', res, { once: true });
        img.addEventListener('error', res, { once: true });
      });
  var fontsReady = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
  var start = (window.performance && performance.now) ? performance.now() : Date.now();

  function now() { return (window.performance && performance.now) ? performance.now() : Date.now(); }

  function bloom() {
    overlay.classList.add('is-bloomed');           // painting sharpens, wordmark fades up (CSS)
    setTimeout(finish, 1050);                        // after the bloom + wordmark beat, dissolve
  }

  overlay.querySelector('.preloader-skip').addEventListener('click', finish);
  document.addEventListener('keydown', function (e) { if (!finished && e.key === 'Escape') finish(); });

  Promise.race([
    Promise.all([imgReady, fontsReady]),
    new Promise(function (res) { setTimeout(res, CAP); })
  ]).then(function () {
    var wait = Math.max(0, MIN - (now() - start));
    setTimeout(bloom, wait);
  });
})();
</script>
