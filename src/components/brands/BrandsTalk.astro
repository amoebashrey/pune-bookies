---
import SectionHead from './SectionHead.astro';
import { settings } from '../../content/site';

const enc = (s: string) => s.split('').map((c) => `&#${c.charCodeAt(0)};`).join('');
const shrey = settings.contacts.find((c) => c.name === 'Shrey')!;
const tanvi = settings.contacts.find((c) => c.name === 'Tanvi')!;
---
<section class="brands-talk" id="get-in-touch" tabindex="-1">
  <div class="container">
    <SectionHead eyebrow="write to us" html="Get in touch" />

    <div class="brands-narrow">
      <p>Tell us what you have in mind.</p>
    </div>

    <form class="inquiry" id="inquiry-form" novalidate>
      <div class="field">
        <label for="inq-name">your name</label>
        <input type="text" id="inq-name" name="name" autocomplete="name" required maxlength="120" />
      </div>
      <div class="field">
        <label for="inq-brand">Brand or organisation (optional)</label>
        <input type="text" id="inq-brand" name="brand" autocomplete="organization" maxlength="160" />
      </div>
      <div class="field">
        <label for="inq-email">email</label>
        <input type="email" id="inq-email" name="email" autocomplete="email" required maxlength="200" />
      </div>
      <div class="field">
        <label for="inq-message">Message</label>
        <textarea id="inq-message" name="message" rows="4" required maxlength="4000" placeholder="a Sunday, roughly sketched"></textarea>
      </div>
      <!-- honeypot: humans never see it, bots can't resist it -->
      <div class="field field-website" aria-hidden="true">
        <label for="inq-website">website</label>
        <input type="text" id="inq-website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <button type="submit" class="inquiry-submit">Send</button>
      <p class="inquiry-status" role="status" aria-live="polite"></p>
    </form>

    <p class="talk-alt">
      Prefer email? Shrey ·
      <a class="obf-mail" data-u={shrey.user} data-d={shrey.domain} href="#get-in-touch" set:html={enc(`${shrey.user}@${shrey.domain}`)} />
      &nbsp;·&nbsp; Tanvi ·
      <a class="obf-mail" data-u={tanvi.user} data-d={tanvi.domain} href="#get-in-touch" set:html={enc(`${tanvi.user}@${tanvi.domain}`)} />
      <br />
      Prefer this page as a PDF? <a href="/media-kit.pdf" data-track="media_kit_click">The media kit</a> has the same notes, printable.
    </p>
  </div>
</section>
