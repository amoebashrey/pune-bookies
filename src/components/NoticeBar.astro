---
/**
 * Sticky notice strip, above the navbar on every page. Sanity-backed
 * (noticeBar singleton) with a hardcoded fallback so it's never empty.
 * The line is computed at request time: a build-time baseline renders
 * here for no-JS, and the inline script below recomputes it in the
 * browser using the same rules (kept in sync with src/lib/noticeBar.ts).
 */
import { getNoticeBar } from '../lib/cms';
import { noticeText } from '../lib/noticeBar';

const data = await getNoticeBar();
const initial = noticeText(data);
---
<div
  class="notice-bar"
  data-next-date={data.nextSundayDate ?? ''}
  data-time={data.time ?? ''}
  data-location={data.location ?? ''}
  data-override={data.overrideText ?? ''}
>
  <span class="notice-text">{initial}</span>
  <a class="notice-cal" href="/sunday.ics" data-track="calendar_add">+ add to calendar</a>
</div>

<script is:inline>
  /* Request-time recompute — IST clock, mirrors src/lib/noticeBar.ts. */
  (function () {
    var el = document.querySelector('.notice-bar');
    if (!el) return;
    var t = el.querySelector('.notice-text');
    if (!t) return;
    var ds = el.dataset;
    var IST = (5 * 60 + 30) * 60 * 1000;
    var now = new Date(Date.now() + IST);
    var override = (ds.override || '').trim();

    function line() {
      if (override) return override;
      var time = (ds.time || '').trim() || '8 AM';
      var loc = (ds.location || '').trim() || 'Mt. Carmel';
      var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec((ds.nextDate || '').trim());
      if (!m) return 'next reading · ' + time + ' · ' + loc;
      var next = Date.UTC(+m[1], +m[2] - 1, +m[3]);
      var today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
      var DAY = 86400000, hour = now.getUTCHours();
      if (today === next) {
        if (hour >= 7 && hour < 10) return 'reading happening now until 10 am · ' + loc + ' · come find us';
        return 'reading today · ' + time + ' · ' + loc;
      }
      if (today + DAY === next) return 'reading tomorrow · ' + time + ' · ' + loc;
      if (today < next) {
        var fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' });
        return 'next reading · sunday, ' + fmt.format(new Date(next)) + ' · ' + time + ' · ' + loc;
      }
      return "we're off this sunday — back the following week";
    }

    t.textContent = line();
  })();
</script>
