---
// Standalone — no navbar/footer; just the squirrel and the way home.
---
<!DOCTYPE html>
<html lang="en-IN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>This page wandered off — Pune Bookies</title>
<meta name="robots" content="noindex" />
<meta name="theme-color" content="#f4ecd8" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..600,0..100,0..1;1,9..144,400..600,0..100,0..1&family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/styles.css" />
<style>
  .lost {
    min-height: 100vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
  }
  .lost-squirrel { width: min(280px, 60vw); margin: 0 auto 2rem; }
  .lost h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin-bottom: 1.2rem;
  }
  .lost h1 em { color: var(--gulmohar); }
  .lost p {
    font-size: 1.05rem;
    color: var(--ink-soft);
    max-width: 34ch;
    margin: 0 auto 2.4rem;
  }
  .lost a.home {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-variation-settings: "SOFT" 100, "opsz" 24;
    font-size: 1.05rem;
  }
</style>
</head>
<body>

<main>
  <section class="lost">
    <div>
      <!-- Watercolour squirrel, mid-errand, no book in sight -->
      <svg class="lost-squirrel" viewBox="0 0 280 220" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <filter id="sq-wash" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.02 0.04" numOctaves="2" seed="11"/>
            <feDisplacementMap in="SourceGraphic" scale="7"/>
          </filter>
          <radialGradient id="sq-body" cx="0.4" cy="0.4" r="0.8">
            <stop offset="0%" stop-color="#a07d5a" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="#8b6748" stop-opacity="0.7"/>
          </radialGradient>
          <radialGradient id="sq-tail" cx="0.5" cy="0.5" r="0.7">
            <stop offset="0%" stop-color="#b56b3a" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="#8b6748" stop-opacity="0.35"/>
          </radialGradient>
        </defs>
        <ellipse cx="140" cy="196" rx="110" ry="12" fill="#9bb07e" opacity="0.3" filter="url(#sq-wash)"/>
        <g filter="url(#sq-wash)">
          <path d="M 178 160 C 230 150 240 96 212 70 C 196 56 174 60 170 80 C 192 78 204 96 196 116 C 190 132 178 140 166 144 Z"
                fill="url(#sq-tail)"/>
          <ellipse cx="132" cy="150" rx="44" ry="34" fill="url(#sq-body)"/>
          <ellipse cx="150" cy="160" rx="22" ry="18" fill="#6e4f33" opacity="0.35"/>
          <ellipse cx="94" cy="116" rx="24" ry="20" fill="url(#sq-body)"/>
          <path d="M 84 100 Q 82 86 92 90 Q 96 96 92 102 Z" fill="#6e4f33" opacity="0.8"/>
          <circle cx="88" cy="112" r="2.6" fill="#1f1611" opacity="0.85"/>
          <circle cx="73" cy="120" r="1.8" fill="#1f1611" opacity="0.7"/>
          <ellipse cx="104" cy="142" rx="7" ry="5" fill="#6e4f33" opacity="0.7"/>
          <ellipse cx="116" cy="146" rx="7" ry="5" fill="#6e4f33" opacity="0.6"/>
        </g>
        <path d="M 58 140 C 63 146 64 154 58 160 C 52 154 53 146 58 140 Z" fill="#c8553d" opacity="0.6" filter="url(#sq-wash)"/>
      </svg>

      <h1 class="display">This page <em>wandered off.</em></h1>
      <p>The squirrel was last seen with it. We take no responsibility for the squirrel.</p>
      <a class="home" href="/">← back under the tree</a>
    </div>
  </section>
</main>

</body>
</html>
